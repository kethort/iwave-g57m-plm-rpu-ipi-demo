def collect_custom_sources(source_dir: Path) -> list[Path]:
    supported_suffixes = {".c", ".h", ".S", ".s"}

    files = [
        path
        for path in sorted(source_dir.rglob("*"))
        if path.is_file() and path.suffix in supported_suffixes
    ]

    if not files:
        fail(
            "No C, header, or assembly files were found in custom source "
            f"directory: {source_dir}"
        )

    return files


def destination_for_source(
    source: Path,
    custom_source_dir: Path,
    plm_source_root: Path,
) -> Path:
    """
    Map custom files into plm/src/common or plm/src/versal.

    Explicit custom-source-dir/common and custom-source-dir/versal layouts
    are honored. Otherwise known Versal platform files go to versal and all
    other files go to common.
    """
    relative = source.relative_to(custom_source_dir)

    if relative.parts and relative.parts[0] == "common":
        return plm_source_root / "common" / Path(*relative.parts[1:])

    if relative.parts and relative.parts[0] == "versal":
        return plm_source_root / "versal" / Path(*relative.parts[1:])

    if source.name in VERSAL_OVERRIDE_FILES:
        return plm_source_root / "versal" / source.name

    return plm_source_root / "common" / source.name


def update_user_compile_sources(
    user_config: Path,
    additional_sources: Iterable[str],
) -> None:
    entries = sorted(set(additional_sources))

    if not entries:
        return

    text = user_config.read_text(encoding="utf-8")

    pattern = re.compile(
        r"set\s*\(\s*USER_COMPILE_SOURCES(?P<body>.*?)\)",
        flags=re.DOTALL,
    )
    match = pattern.search(text)

    if match is None:
        block = "\nset(USER_COMPILE_SOURCES\n"
        for entry in entries:
            block += f'    "${{CMAKE_CURRENT_SOURCE_DIR}}/{entry}"\n'
        block += ")\n"

        user_config.write_text(
            text.rstrip() + "\n" + block,
            encoding="utf-8",
        )
        info(f"Created USER_COMPILE_SOURCES in {user_config}")
        return

    existing_body = match.group("body")
    existing_entries = set(
        re.findall(
            r"(?:common|versal)/[A-Za-z0-9_.+\-/]+\.(?:c|s|S)",
            existing_body,
        )
    )

    merged = sorted(existing_entries.union(entries))

    replacement = "set(USER_COMPILE_SOURCES\n"
    for entry in merged:
        replacement += (
            f'    "${{CMAKE_CURRENT_SOURCE_DIR}}/{entry}"\n'
        )
    replacement += ")"

    updated = (
        text[: match.start()]
        + replacement
        + text[match.end() :]
    )

    user_config.write_text(updated, encoding="utf-8")
    info(f"Updated USER_COMPILE_SOURCES in {user_config}")


def configure_plm_debug_build(plm_source_root: Path) -> None:
    """Disable optimization and LTO for overlaid PLM user sources."""
    user_config = plm_source_root / "UserConfig.cmake"
    cmake_lists = plm_source_root / "CMakeLists.txt"

    if not user_config.is_file():
        fail(f"Generated UserConfig.cmake not found: {user_config}")
    if not cmake_lists.is_file():
        fail(f"Generated CMakeLists.txt not found: {cmake_lists}")

    user_config_text = user_config.read_text(encoding="utf-8")

    # Clean up target-wide flags written by older build-plm revisions. A
    # link-wide -fno-lto makes the PLM exceed PPU TMR RAM; only user sources
    # should opt out of LTO.
    cleaned_user_config = user_config_text
    for variable in (
        "USER_COMPILE_OTHER_FLAGS",
        "USER_LINK_OTHER_FLAGS",
    ):
        pattern = re.compile(
            rf"(?P<opening>set\s*\(\s*{re.escape(variable)}\b)"
            r"(?P<body>.*?)\)",
            flags=re.DOTALL,
        )
        match = pattern.search(cleaned_user_config)
        if match is None or "-fno-lto" not in match.group("body"):
            continue

        cleaned_body = match.group("body").replace("-fno-lto", "")
        replacement = match.group("opening") + cleaned_body + ")"
        cleaned_user_config = (
            cleaned_user_config[:match.start()]
            + replacement
            + cleaned_user_config[match.end():]
        )

    if cleaned_user_config != user_config_text:
        user_config.write_text(cleaned_user_config, encoding="utf-8")
        user_config_text = cleaned_user_config
        info("Removed stale target-wide -fno-lto flags")

    source_match = re.search(
        r"set\s*\(\s*USER_COMPILE_SOURCES(?P<body>.*?)\)",
        user_config_text,
        flags=re.DOTALL,
    )
    if source_match is None:
        info("No overlaid PLM compile sources require debug flags")
        return

    sources = sorted(
        set(
            re.findall(
                r"(?:common|versal)/[A-Za-z0-9_.+\-/]+\.(?:c|s|S)",
                source_match.group("body"),
            )
        )
    )
    if not sources:
        info("No overlaid PLM compile sources require debug flags")
        return

    begin_marker = "# build-plm debug sources: begin"
    end_marker = "# build-plm debug sources: end"
    lines = [
        begin_marker,
        "set_source_files_properties(",
    ]
    lines.extend(
        f'    "${{CMAKE_CURRENT_SOURCE_DIR}}/{source}"'
        for source in sources
    )
    lines.extend(
        [
            '    PROPERTIES COMPILE_OPTIONS '
            '"-O0;-g3;-fno-lto;-fno-omit-frame-pointer"',
            ")",
            end_marker,
        ]
    )
    block = "\n".join(lines)

    text = cmake_lists.read_text(encoding="utf-8")
    existing = re.compile(
        rf"{re.escape(begin_marker)}.*?{re.escape(end_marker)}",
        flags=re.DOTALL,
    )
    if existing.search(text):
        updated = existing.sub(block, text, count=1)
    else:
        insertion_marker = "add_dependency_on_bsp(_sources)"
        if insertion_marker not in text:
            fail(
                "Could not locate add_dependency_on_bsp(_sources) in "
                f"{cmake_lists}"
            )
        updated = text.replace(
            insertion_marker,
            block + "\n\n" + insertion_marker,
            1,
        )

    if updated != text:
        cmake_lists.write_text(updated, encoding="utf-8")

    info(
        "Configured PLM user-source debug flags "
        "(-O0 -g3 -fno-lto -fno-omit-frame-pointer) "
        f"for {len(sources)} source(s)"
    )


def overlay_custom_sources(
    custom_source_dir: Path,
    plm_source_root: Path,
    use_symlinks: bool,
    copy_linker_script: bool,
) -> None:
    if not custom_source_dir.is_dir():
        fail(f"Custom PLM source directory not found: {custom_source_dir}")

    user_config = plm_source_root / "UserConfig.cmake"

    if not user_config.is_file():
        fail(f"Generated UserConfig.cmake not found: {user_config}")

    custom_files = collect_custom_sources(custom_source_dir)
    additional_compile_sources: list[str] = []

    for source in custom_files:
        destination = destination_for_source(
            source,
            custom_source_dir,
            plm_source_root,
        )

        symlink_or_copy(source, destination, use_symlinks)

        if source.suffix in {".c", ".S", ".s"}:
            additional_compile_sources.append(
                destination.relative_to(plm_source_root).as_posix()
            )

    custom_linker = custom_source_dir / "lscript.ld"
    generated_linker = plm_source_root / "versal" / "lscript.ld"

    if copy_linker_script:
        if not custom_linker.is_file():
            fail(
                "--copy-linker-script was requested, but no linker script "
                f"exists at: {custom_linker}"
            )

        symlink_or_copy(
            custom_linker,
            generated_linker,
            use_symlink=False,
        )
    elif custom_linker.exists():
        info(
            f"Ignoring {custom_linker}; use --copy-linker-script to "
            "replace the generated linker script."
        )

    update_user_compile_sources(
        user_config,
        additional_compile_sources,
    )



def patch_plm_module_init(
    app_common_dir: Path,
    header_name: str,
    init_function: str,
) -> None:
    module_c = app_common_dir / "xplm_module.c"

    if not module_c.is_file():
        fail(f"xplm_module.c not found: {module_c}")

    data = module_c.read_text(encoding="utf-8")

    # Add the custom header after the complete conditional include section,
    # not after the final #include line, which may be inside an #ifdef.
    include_line = f'#include "{header_name}"'

    if include_line not in data:
        include_marker = "/************************** Constant Definitions"
        include_index = data.find(include_marker)

        if include_index < 0:
            fail(
                "Could not locate the Constant Definitions marker in "
                f"{module_c}"
            )

        data = (
            data[:include_index]
            + include_line
            + "\n\n"
            + data[include_index:]
        )
        info(f"Added {include_line} to {module_c}")
    else:
        info(f"{include_line} already exists in {module_c}")

    function_match = re.search(
        r"\bint\s+XPlm_ModuleInit\s*\([^)]*\)\s*\{",
        data,
    )
    if function_match is None:
        fail(f"Could not find XPlm_ModuleInit() in {module_c}")

    # Insert before END:. Code after END: is part of the error path and would
    # overwrite a prior failure status.
    end_match = re.search(
        r"^[ \t]*END:[ \t]*$",
        data[function_match.end():],
        re.MULTILINE,
    )
    if end_match is None:
        fail(f"Could not find END: label in XPlm_ModuleInit() in {module_c}")

    insert_index = function_match.end() + end_match.start()
    call_pattern = re.compile(
        rf"\bStatus\s*=\s*{re.escape(init_function)}\s*\(\s*\)\s*;"
    )

    if call_pattern.search(data, function_match.end(), insert_index):
        info(f"{init_function}() is already registered in XPlm_ModuleInit()")
    else:
        block = (
            "\t/** Initialize custom user module */\n"
            f"\tStatus = {init_function}();\n"
            "\tif (Status != XST_SUCCESS) {\n"
            "\t\tgoto END;\n"
            "\t}\n\n"
        )
        data = data[:insert_index] + block + data[insert_index:]
        info(f"Registered {init_function}() in XPlm_ModuleInit()")

    module_c.write_text(data, encoding="utf-8")


def xilplmi_bsp_dir(workspace: Path) -> Path:
    return workspace / PLATFORM_NAME / PROCESSOR_NAME / DOMAIN_NAME / "bsp"


def read_xplmi_max_modules_value(modules_header: Path) -> str:
    if not modules_header.is_file():
        return "(15U)"
    match = re.search(
        r"^\s*#define\s+XPLMI_MAX_MODULES\s+(.+?)\s*$",
        modules_header.read_text(encoding="utf-8"),
        flags=re.MULTILINE,
    )
    return match.group(1).strip() if match else "(15U)"


def patch_xilplmi_user_module_headers(workspace: Path) -> int:
    bsp = xilplmi_bsp_dir(workspace)
    header_pairs = [
        (bsp / "libsrc/xilplmi/src/common/server/xplmi_cmd.h", bsp / "libsrc/xilplmi/src/common/server/xplmi_modules.h"),
        (bsp / "libsrc/build_configs/gen_bsp/include/xplmi_cmd.h", bsp / "libsrc/build_configs/gen_bsp/include/xplmi_modules.h"),
        (bsp / "include/xplmi_cmd.h", bsp / "include/xplmi_modules.h"),
    ]
    patched = 0
    for cmd_header, modules_header in header_pairs:
        if not cmd_header.is_file():
            continue
        data = cmd_header.read_text(encoding="utf-8")
        if "#define XPLMI_USER_MODULE_START_INDEX" not in data:
            value = read_xplmi_max_modules_value(modules_header)
            patch = (
                "\n/* Workaround for Vitis 2025.2 xilplmi user-module include-order bug. */\n"
                "#ifndef XPLMI_USER_MODULE_START_INDEX\n"
                f"#define XPLMI_USER_MODULE_START_INDEX {value}\n"
                "#endif\n"
            )
            guard = re.search(r"^\s*#define\s+XPLMI_CMD_H.*$", data, flags=re.MULTILINE)
            index = guard.end() if guard else 0
            cmd_header.write_text(data[:index] + patch + data[index:], encoding="utf-8")
            info(f"Patched user-module start index into {cmd_header}")
            patched += 1
        if modules_header.is_file():
            modules_data = modules_header.read_text(encoding="utf-8")
            if "#ifndef XPLMI_USER_MODULE_START_INDEX" not in modules_data:
                pattern = re.compile(
                    r"^(\s*#define\s+XPLMI_USER_MODULE_START_INDEX\s+\(\s*XPLMI_MAX_MODULES\s*\)\s*)$",
                    flags=re.MULTILINE,
                )
                match = pattern.search(modules_data)
                if match:
                    replacement = "#ifndef XPLMI_USER_MODULE_START_INDEX\n" + match.group(1) + "\n#endif"
                    modules_header.write_text(pattern.sub(replacement, modules_data, count=1), encoding="utf-8")
                    info(f"Guarded user-module start index in {modules_header}")
    return patched


def configure_xilplmi_user_modules(platform: object, count: int) -> None:
    domain = platform.get_domain(name=DOMAIN_NAME)
    result = domain.set_config(
        option="lib",
        lib_name="xilplmi",
        param="XILPLMI_user_modules_count",
        value=str(count),
    )
    debug(f"XILPLMI_user_modules_count set_config returned: {result!r}")


def build_platform_with_user_module_patch(platform: object, workspace: Path, count: Optional[int]) -> None:
    if count is not None:
        configure_xilplmi_user_modules(platform, count)
        generate = getattr(platform, "generate", None)
        if generate is not None:
            info("Generating platform sources before applying xilplmi workaround")
            try:
                generate()
            except Exception as error:
                info(f"platform.generate() reported: {error}; continuing to build/patch retry")
        patch_xilplmi_user_module_headers(workspace)

    info("Building platform")
    try:
        result = platform.build()
        debug(f"platform.build() returned: {result!r}")
        if isinstance(result, bool) and not result:
            raise RuntimeError("platform build failed")
        if isinstance(result, int) and result != 0:
            raise RuntimeError(f"platform build failed with return code {result}")
    except Exception:
        if count is None:
            raise
        info("Initial platform build failed; applying generated-header workaround and retrying once")
        if patch_xilplmi_user_module_headers(workspace) == 0:
            info("No generated xilplmi headers were patched before retry")
        result = platform.build()
        debug(f"platform.build() retry returned: {result!r}")
        if isinstance(result, bool) and not result:
            fail("platform build retry failed")
        if isinstance(result, int) and result != 0:
            fail(f"platform build retry failed with return code {result}")


def parse_arguments(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Create or reuse a Versal PLM workspace, overlay custom source "
            "files, build plm.elf, optionally build an RPU application, and generate the launch PDI."
        )
    )

    parser.add_argument(
        "workspace",
        help="Vitis workspace directory",
    )
    parser.add_argument(
        "--xsa",
        help=(
            "Hardware XSA. Required when creating or forcibly regenerating "
            "the platform; optional when reusing an existing platform."
        ),
    )
    parser.add_argument(
        "--custom-source-dir",
        default=None,
        help=(
            "Directory containing custom PLM source/header files. "
            "Default: <script-directory>/src"
        ),
    )
    parser.add_argument(
        "--symlink-sources",
        action="store_true",
        help="Symlink custom files into the generated PLM component",
    )
    parser.add_argument(
        "--copy-linker-script",
        action="store_true",
        help=(
            "Replace plm/src/versal/lscript.ld with "
            "<custom-source-dir>/lscript.ld"
        ),
    )
    parser.add_argument(
        "--no-custom-sources",
        action="store_true",
        help="Build without applying a custom source overlay",
    )
    parser.add_argument(
        "--force-regenerate",
        action="store_true",
        help=(
            "Delete the existing platform and PLM components, then recreate "
            "them from --xsa before building"
        ),
    )
    parser.add_argument(
        "--rebuild-platform",
        action="store_true",
        help=(
            "Build and export the existing platform again before building "
            "PLM"
        ),
    )
    parser.add_argument(
        "--user-modules-count",
        type=lambda value: int(value, 0),
        default=None,
        help="Configure XILPLMI_user_modules_count and patch the Vitis 2025.2 generated-header bug",
    )
    parser.add_argument(
        "--register-module",
        default=None,
        metavar="HEADER:FUNCTION",
        help="Patch XPlm_ModuleInit() to call a user-module initialization function",
    )
    parser.add_argument(
        "--rpu-source",
        default=None,
        help=(
            "Directory containing RPU C/header/assembly sources, or a Rust "
            "Cargo workspace containing Cargo.toml"
        ),
    )
    parser.add_argument(
        "--rpu-elf",
        default=None,
        help="Use an existing RPU ELF instead of generating/building an RPU application",
    )

    parser.add_argument(
        "--rpu-component-dir",
        default=None,
        help=(
            "Existing Vitis RPU application-component directory containing "
            "vitis-comp.json. When --rpu-elf is used, the default is inferred "
            "as <rpu-elf-parent>/.. and the component is symlinked into the "
            "main workspace so it is visible in Vitis."
        ),
    )
    parser.add_argument(
        "--rpu-app-name",
        default=RPU_APPLICATION_NAME_DEFAULT,
        help=f"RPU application component name (default: {RPU_APPLICATION_NAME_DEFAULT})",
    )
    parser.add_argument(
        "--rpu-platform-name",
        default=RPU_PLATFORM_NAME_DEFAULT,
        help=f"RPU platform component name (default: {RPU_PLATFORM_NAME_DEFAULT})",
    )
    parser.add_argument(
        "--rpu-processor",
        default=RPU_PROCESSOR_NAME_DEFAULT,
        help=f"RPU processor instance (default: {RPU_PROCESSOR_NAME_DEFAULT})",
    )
    parser.add_argument(
        "--rpu-domain",
        default=RPU_DOMAIN_NAME_DEFAULT,
        help=f"RPU standalone domain name (default: {RPU_DOMAIN_NAME_DEFAULT})",
    )
    parser.add_argument(
        "--rpu-template",
        default=RPU_APPLICATION_TEMPLATE_DEFAULT,
        help=f"RPU application template (default: {RPU_APPLICATION_TEMPLATE_DEFAULT})",
    )
    parser.add_argument(
        "--rpu-core",
        choices=("r5-0", "r5-1", "r5-lockstep"),
        default="r5-0",
        help="Bootgen core assignment for the RPU ELF (default: r5-0)",
    )
    parser.add_argument(
        "--embed-rpu-in-pdi",
        action="store_true",
        help=(
            "Additionally generate PLM_RPU_PRODUCTION.pdi containing both "
            "the custom PLM and RPU ELF. The Vitis debug launch still uses "
            "the PLM-only PDI."
        ),
    )
    parser.add_argument(
        "--rpu-cargo-package",
        default=None,
        help="Rust package/binary name (default: --rpu-app-name)",
    )
    parser.add_argument(
        "--rpu-cargo-target",
        default="armv7r-none-eabihf",
        help="Rust target triple (default: armv7r-none-eabihf)",
    )
    parser.add_argument(
        "--rpu-cargo-release",
        action="store_true",
        help="Build Rust RPU firmware with Cargo's release profile",
    )
    parser.add_argument(
        "--launch-vitis",
        action="store_true",
        help="Launch the Vitis GUI after a successful build",
    )

    args = parser.parse_args(argv)

    if args.no_custom_sources and args.custom_source_dir:
        parser.error(
            "--no-custom-sources cannot be combined with "
            "--custom-source-dir"
        )

    if args.no_custom_sources and args.symlink_sources:
        parser.error(
            "--no-custom-sources cannot be combined with "
            "--symlink-sources"
        )

    if args.no_custom_sources and args.copy_linker_script:
        parser.error(
            "--no-custom-sources cannot be combined with "
            "--copy-linker-script"
        )

    if args.force_regenerate and not args.xsa:
        parser.error("--force-regenerate requires --xsa")

    if args.user_modules_count is not None and args.user_modules_count < 0:
        parser.error("--user-modules-count must be >= 0")

    if args.register_module is not None and ":" not in args.register_module:
        parser.error("--register-module requires HEADER:FUNCTION")

    if args.rpu_source and args.rpu_elf:
        parser.error("--rpu-source and --rpu-elf are mutually exclusive")

    if args.rpu_component_dir and not args.rpu_elf:
        parser.error("--rpu-component-dir requires --rpu-elf")

    if (args.rpu_source or args.rpu_elf) and not args.xsa:
        parser.error("RPU generation/packaging requires --xsa")

    if args.embed_rpu_in_pdi and not (args.rpu_source or args.rpu_elf):
        parser.error("--embed-rpu-in-pdi requires --rpu-source or --rpu-elf")

    if args.rpu_source and args.rpu_platform_name == PLATFORM_NAME:
        parser.error(
            f"--rpu-platform-name must differ from the PLM platform name "
            f"'{PLATFORM_NAME}'. Omit the option to use "
            f"'{RPU_PLATFORM_NAME_DEFAULT}', or choose another unique name. "
            "The PLM platform contains the PMC domain and cannot be reused "
            "as the script's RPU platform."
        )

    if args.rpu_source and args.rpu_app_name in {
        PLATFORM_NAME,
        APPLICATION_NAME,
        args.rpu_platform_name,
    }:
        parser.error(
            "--rpu-app-name must differ from the PLM platform, PLM "
            "application, and RPU platform component names"
        )

    if args.register_module is not None and args.user_modules_count is None:
        args.user_modules_count = 1

    return args


def main() -> int:
    args = parse_arguments(sys.argv[1:])

    script_dir = Path(__file__).resolve().parent
    workspace = absolute_path(args.workspace)

    xsa: Optional[Path] = None
    if args.xsa:
        xsa = absolute_path(args.xsa)
        if not xsa.is_file():
            fail(f"XSA not found: {xsa}")

    rpu_source: Optional[Path] = None
    rpu_source_is_rust = False
    if args.rpu_source:
        rpu_source = absolute_path(args.rpu_source)
        if not rpu_source.is_dir():
            fail(f"RPU source directory not found: {rpu_source}")
        rpu_source_is_rust = (rpu_source / "Cargo.toml").is_file()

    requested_rpu_elf: Optional[Path] = None
    existing_rpu_component_dir: Optional[Path] = None
    if args.rpu_elf:
        requested_rpu_elf = absolute_path(args.rpu_elf)
        if not requested_rpu_elf.is_file():
            fail(f"RPU ELF not found: {requested_rpu_elf}")

        explicit_component_dir = (
            absolute_path(args.rpu_component_dir)
            if args.rpu_component_dir
            else None
        )
        existing_rpu_component_dir = resolve_rpu_component_dir(
            requested_rpu_elf,
            explicit_component_dir,
        )

    if args.no_custom_sources:
        custom_source_dir: Optional[Path] = None
    elif args.custom_source_dir:
        custom_source_dir = absolute_path(args.custom_source_dir)
    else:
        custom_source_dir = (script_dir / "src").resolve()

    platform_dir = workspace / PLATFORM_NAME
    application_dir = workspace / APPLICATION_NAME
    rpu_platform_dir = workspace / args.rpu_platform_name
    rpu_application_dir = workspace / args.rpu_app_name

    if args.force_regenerate:
        info("Force regeneration requested")

        if platform_dir.exists() or platform_dir.is_symlink():
            info(f"Removing existing platform: {platform_dir}")
            remove_path(platform_dir)

        if application_dir.exists() or application_dir.is_symlink():
            info(f"Removing existing PLM application: {application_dir}")
            remove_path(application_dir)

        if rpu_source is not None or requested_rpu_elf is not None:
            for label, path in (
                ("RPU platform", rpu_platform_dir),
                ("RPU application", rpu_application_dir),
            ):
                if path.exists() or path.is_symlink():
                    info(f"Removing existing {label}: {path}")
                    remove_path(path)

    platform_exists = platform_dir.is_dir()
    application_exists = application_dir.is_dir()

    if not platform_exists and xsa is None:
        fail(
            f"No existing platform was found at {platform_dir}. "
            "Provide --xsa to create it."
        )

    workspace.mkdir(parents=True, exist_ok=True)

    info(f"Workspace: {workspace}")

    if xsa is not None:
        info(f"XSA: {xsa}")
    else:
        info("XSA: not required because the existing platform will be reused")

    if custom_source_dir is None:
        info("Custom source overlay: disabled")
    else:
        info(f"Custom source directory: {custom_source_dir}")
        info(
            "Overlay mode: "
            + ("symlink" if args.symlink_sources else "copy")
        )

    if rpu_source is not None:
        info(f"RPU source directory: {rpu_source}")
        info(
            "RPU implementation: "
            + ("Rust/Cargo with generated BSP bindings" if rpu_source_is_rust else "C")
        )
        info(f"RPU processor/domain: {args.rpu_processor}/{args.rpu_domain}")
        info(f"RPU bootgen core: {args.rpu_core}")
    elif requested_rpu_elf is not None:
        info(f"Using existing RPU ELF: {requested_rpu_elf}")
        assert existing_rpu_component_dir is not None
        info(f"Existing RPU component directory: {existing_rpu_component_dir}")
        expose_existing_rpu_component(
            workspace=workspace,
            component_dir=existing_rpu_component_dir,
            app_name=args.rpu_app_name,
        )

    prepare_workspace_for_headless_build(workspace)

    try:
        import vitis
    except ImportError as error:
        raise RuntimeError(
            "The Vitis Python module is unavailable. Run this script with "
            "'vitis -s', not the host python3 interpreter."
        ) from error

    client, owned_server_roots = create_client_and_set_workspace(
        vitis,
        workspace,
    )

    try:

        if platform_exists:
            info(f"Reusing existing platform component '{PLATFORM_NAME}'")
            platform = get_existing_component(
                client,
                PLATFORM_NAME,
                "platform",
            )

            exported_platform = resolve_exported_platform(workspace)

            if args.rebuild_platform or args.user_modules_count is not None:
                build_platform_with_user_module_patch(
                    platform, workspace, args.user_modules_count
                )
                export_platform(platform)
                exported_platform = resolve_exported_platform(workspace)
        else:
            assert xsa is not None
            platform = create_platform(client, xsa)
            build_platform_with_user_module_patch(
                platform, workspace, args.user_modules_count
            )
            export_platform(platform)
            exported_platform = resolve_exported_platform(workspace)

        info(f"Exported platform: {exported_platform}")
        add_platform_repository(client, exported_platform)

        if application_exists:
            info(
                f"Reusing existing PLM application component "
                f"'{APPLICATION_NAME}'"
            )
            application = get_existing_component(
                client,
                APPLICATION_NAME,
                "application",
            )
        else:
            application = create_plm_application(
                client,
                exported_platform,
            )

        plm_source_root = application_dir / "src"

        if not plm_source_root.is_dir():
            fail(
                "The PLM source directory was not found after opening or "
                f"creating the component: {plm_source_root}"
            )

        if custom_source_dir is not None:
            overlay_custom_sources(
                custom_source_dir=custom_source_dir,
                plm_source_root=plm_source_root,
                use_symlinks=args.symlink_sources,
                copy_linker_script=args.copy_linker_script,
            )

        configure_plm_debug_build(plm_source_root)

        if args.register_module is not None:
            header_name, init_function = args.register_module.split(":", 1)
            patch_plm_module_init(
                plm_source_root / "common", header_name, init_function
            )

        plm_elf = application_dir / "build" / "plm.elf"

        if plm_elf.exists() or plm_elf.is_symlink():
            info(f"Removing stale PLM ELF before build: {plm_elf}")
            remove_path(plm_elf)

        build_component(application, "PLM application")

        if not plm_elf.is_file():
            fail(
                "The PLM build completed, but the output ELF was not found: "
                f"{plm_elf}"
            )

        success(f"PLM build complete: {plm_elf}")

        packaged_rpu_elf: Optional[Path] = requested_rpu_elf
        if rpu_source is not None:
            assert xsa is not None

            if rpu_platform_dir.is_dir():
                info(f"Reusing existing RPU platform '{args.rpu_platform_name}'")
                rpu_platform = get_existing_component(
                    client, args.rpu_platform_name, "platform"
                )
            else:
                rpu_platform = create_rpu_platform(
                    client,
                    xsa,
                    args.rpu_platform_name,
                    args.rpu_processor,
                    args.rpu_domain,
                )

            build_component(rpu_platform, "RPU platform")
            export_platform(rpu_platform)
            rpu_exported_platform = resolve_exported_platform_named(
                workspace, args.rpu_platform_name
            )
            add_platform_repository(client, rpu_exported_platform)

            if rpu_application_dir.is_dir():
                info(f"Reusing existing RPU application '{args.rpu_app_name}'")
                rpu_application = get_existing_component(
                    client, args.rpu_app_name, "application"
                )
            else:
                rpu_application = create_rpu_application(
                    client,
                    rpu_exported_platform,
                    args.rpu_app_name,
                    args.rpu_domain,
                    args.rpu_template,
                )

            rpu_source_root = rpu_application_dir / "src"

            if rpu_source_is_rust:
                overlay_rust_rpu_sources(
                    rpu_source,
                    rpu_source_root,
                    args.rpu_cargo_package or args.rpu_app_name,
                    args.symlink_sources,
                )
            else:
                source_absolute = rpu_source.expanduser().absolute()
                destination_absolute = rpu_source_root.expanduser().absolute()

                if source_absolute == destination_absolute:
                    info(
                        "RPU source directory is already the application component "
                        f"source directory; skipping source overlay: {source_absolute}"
                    )
                else:
                    overlay_rpu_sources(
                        rpu_source,
                        rpu_source_root,
                        args.symlink_sources,
                    )


            packaged_rpu_elf = rpu_application_dir / "build" / f"{args.rpu_app_name}.elf"
            if packaged_rpu_elf.exists() or packaged_rpu_elf.is_symlink():
                info(f"Removing stale RPU ELF before build: {packaged_rpu_elf}")
                remove_path(packaged_rpu_elf)

            if rpu_source_is_rust:
                linker_script = rpu_source_root / "lscript.ld"
                if not linker_script.is_file():
                    fail(
                        "The Vitis RPU component did not generate its linker script: "
                        f"{linker_script}"
                    )
                cargo_elf = build_rust_rpu_application(
                    cargo_root=rpu_source,
                    workspace=workspace,
                    platform_name=args.rpu_platform_name,
                    domain_name=args.rpu_domain,
                    package_name=(
                        args.rpu_cargo_package or args.rpu_app_name
                    ),
                    target_name=args.rpu_cargo_target,
                    linker_script=linker_script,
                    release=args.rpu_cargo_release,
                    features=("remoteproc",),
                )
                packaged_rpu_elf.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(cargo_elf, packaged_rpu_elf)
                info(f"Installed Cargo ELF in Vitis component: {packaged_rpu_elf}")
            else:
                build_component(rpu_application, "RPU application")

            if not packaged_rpu_elf.is_file():
                candidates = sorted((rpu_application_dir / "build").glob("*.elf"))
                if len(candidates) == 1:
                    packaged_rpu_elf = candidates[0]
                else:
                    fail(
                        "The RPU build completed, but a unique ELF was not found beneath "
                        f"{rpu_application_dir / 'build'}"
                    )
            success(f"RPU build complete: {packaged_rpu_elf}")

        vitis_pdi: Optional[Path] = None
        if xsa is not None:
            # Debug launch: program only the custom PLM. The RPU application is
            # built as a separate component and is not loaded by the PLM launch.
            vitis_pdi = generate_custom_plm_pdi(
                workspace=workspace,
                xsa=xsa,
                plm_elf=plm_elf,
                rpu_elf=None,
                rpu_core=args.rpu_core,
                install_for_vitis=True,
                output_stem="PLM_CUSTOM_JTAG",
            )

            # Optional production artifact: boot both processors directly from
            # one PDI, but never install it as the Vitis debug launch PDI.
            if args.embed_rpu_in_pdi:
                assert packaged_rpu_elf is not None
                production_pdi = generate_custom_plm_pdi(
                    workspace=workspace,
                    xsa=xsa,
                    plm_elf=plm_elf,
                    rpu_elf=packaged_rpu_elf,
                    rpu_core=args.rpu_core,
                    install_for_vitis=False,
                    output_stem="PLM_RPU_PRODUCTION",
                )
                success(f"Production combined PDI: {production_pdi}")
        else:
            existing_pdis = sorted(
                (application_dir / "_ide" / "bootimage" / "resources").glob("*.pdi")
            )
            if len(existing_pdis) == 1:
                vitis_pdi = existing_pdis[0]
                info(f"Reusing existing Vitis launch PDI: {vitis_pdi}")
            elif args.launch_vitis:
                info(
                    "No --xsa was supplied, so a new custom PDI was not generated. "
                    "The existing launch configuration PDI path will be retained."
                )

        patch_launch_configs(
            workspace,
            vitis_pdi=vitis_pdi,
            rpu_application_dir=(
                rpu_application_dir
                if packaged_rpu_elf is not None
                else None
            ),
            rpu_app_name=(
                args.rpu_app_name
                if packaged_rpu_elf is not None
                else None
            ),
            rpu_processor=(
                args.rpu_processor
                if packaged_rpu_elf is not None
                else None
            ),
            rpu_elf=packaged_rpu_elf,
            rpu_source_root=(
                rpu_source
                if packaged_rpu_elf is not None and rpu_source_is_rust
                else None
            ),
        )

    finally:
        close_vitis_client(client)
        terminate_vitis_server_roots(
            owned_server_roots,
            "Vitis server started by build-plm",
        )

        if not vitis_server_root_processes():
            remove_stale_workspace_locks(workspace)

    if args.launch_vitis:
        launch_vitis_gui(workspace)

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\n[ERROR] Interrupted", file=sys.stderr)
        raise SystemExit(130)
    except Exception as error:
        print(f"[ERROR] {error}", file=sys.stderr)
        raise SystemExit(1)
