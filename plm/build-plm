def overlay_rpu_sources(
    source_dir: Path,
    app_source_root: Path,
    use_symlinks: bool,
) -> None:
    """Overlay C, assembly, and header files into an RPU application."""

    if not source_dir.is_dir():
        fail(f"RPU source directory not found: {source_dir}")

    supported = {".c", ".h", ".S", ".s"}

    sources = [
        path
        for path in sorted(source_dir.rglob("*"))
        if path.is_file() and path.suffix in supported
    ]

    if not sources:
        fail(
            "No C, header, or assembly files found in RPU source directory: "
            f"{source_dir}"
        )

    app_source_root.mkdir(parents=True, exist_ok=True)

    compile_entries: list[str] = []

    for source in sources:
        relative = source.relative_to(source_dir)
        destination = app_source_root / relative

        symlink_or_copy(
            source,
            destination,
            use_symlink=use_symlinks,
        )

        if source.suffix in {".c", ".S", ".s"}:
            compile_entries.append(relative.as_posix())

    # A custom RPU linker script is optional. When one is not supplied,
    # retain the linker script generated by the Vitis application template.
    custom_linker = source_dir / "lscript.ld"

    if custom_linker.is_file():
        generated_linker = app_source_root / "lscript.ld"

        symlink_or_copy(
            custom_linker,
            generated_linker,
            use_symlink=False,
        )

        info(f"Installed custom RPU linker script: {custom_linker}")
    else:
        info(
            "No custom RPU lscript.ld was provided; retaining the "
            "Vitis-generated linker script"
        )

    user_config = app_source_root / "UserConfig.cmake"

    if user_config.is_file():
        update_user_compile_sources(
            user_config,
            compile_entries,
        )
    else:
        info(
            "RPU UserConfig.cmake was not present; relying on generated "
            "application source discovery"
        )

def overlay_rust_rpu_sources(
    cargo_root: Path,
    app_source_root: Path,
    package_name: str,
    use_symlinks: bool,
) -> None:
    """Expose Rust sources in the Vitis component without copying Cargo output."""
    template_sources = (
        app_source_root / "main.c",
        app_source_root / "helloworld.c",
        app_source_root / "Empty_application.c",
        app_source_root / "Empty_applicationExample.c",
    )
    for template_source in template_sources:
        if template_source.exists() or template_source.is_symlink():
            remove_path(template_source)
            info(f"Removed generated C template source: {template_source}")

    rust_root = app_source_root / "rust"
    rust_root.mkdir(parents=True, exist_ok=True)

    entries = (
        cargo_root / "Cargo.toml",
        cargo_root / "Cargo.lock",
        cargo_root / ".cargo",
        cargo_root / "bsp_bindings",
        cargo_root / package_name,
    )

    for source in entries:
        if not source.exists():
            continue
        destination = rust_root / source.name
        if destination.exists() or destination.is_symlink():
            remove_path(destination)
        if use_symlinks:
            destination.symlink_to(source.resolve(), target_is_directory=source.is_dir())
            info(f"Symlinked {destination} -> {source.resolve()}")
        elif source.is_dir():
            shutil.copytree(
                source,
                destination,
                ignore=shutil.ignore_patterns("target"),
            )
            info(f"Copied {source} -> {destination}")
        else:
            shutil.copy2(source, destination)
            info(f"Copied {source} -> {destination}")

    readme = app_source_root / "README.txt"
    readme.write_text(
        "This Vitis application component is a container for the Rust RPU "
        "firmware.\n\n"
        "The source tree shown here is a symlink mirror of the real Cargo "
        "workspace:\n"
        f"{cargo_root.resolve()}\n\n"
        "build-plm maps debugger source paths from the real Cargo workspace to "
        "this Explorer-visible tree, then copies the generated ELF to this "
        "component's build directory.\n",
        encoding="utf-8",
    )
    info(f"Wrote Rust RPU component note: {readme}")


def derive_vitis_root() -> Path:
    configured = os.environ.get("XILINX_VITIS")
    if configured:
        root = Path(configured).resolve()
        if (root / "gnu" / "armr5").is_dir():
            return root

    launcher = locate_vitis_launcher()
    if launcher is not None:
        for parent in launcher.parents:
            if (parent / "gnu" / "armr5").is_dir():
                return parent

    fail(
        "Unable to locate the Vitis installation root. Source the matching "
        "Vitis settings64.sh before building the Rust RPU firmware."
    )


def discover_arm_r5_gcc(vitis_root: Path) -> Path:
    toolchain_root = vitis_root / "gnu" / "armr5" / "lin"
    for name in (
        "armr5-none-eabi-gcc",
        "arm-none-eabi-gcc",
        "armrm-xilinx-eabi-gcc",
    ):
        for candidate in sorted(toolchain_root.rglob(name)):
            if candidate.is_file() and os.access(candidate, os.X_OK):
                return candidate.resolve()
    fail(f"Unable to find the Vitis ARM-R5 GCC beneath {toolchain_root}")


def gcc_query(gcc: Path, argument: str) -> str:
    result = subprocess.run(
        [str(gcc), argument],
        capture_output=True,
        text=True,
        check=True,
    )
    return result.stdout.strip()


def discover_arm_r5_environment(vitis_root: Path) -> dict[str, str]:
    gcc = discover_arm_r5_gcc(vitis_root)
    sysroot_text = gcc_query(gcc, "--print-sysroot")
    sysroot = Path(sysroot_text).resolve() if sysroot_text else None
    include_dirs: list[Path] = []

    for query in ("include", "include-fixed"):
        value = gcc_query(gcc, f"-print-file-name={query}")
        candidate = Path(value)
        if value != query and candidate.is_dir():
            include_dirs.append(candidate.resolve())

    if sysroot is not None:
        for relative in (Path("usr/include"), Path("include")):
            candidate = sysroot / relative
            if candidate.is_dir():
                include_dirs.append(candidate.resolve())

    toolchain_root = vitis_root / "gnu" / "armr5" / "lin"
    for header in sorted(toolchain_root.glob("*/usr/include/ctype.h")):
        include_dirs.append(header.parent.resolve())

    unique_dirs = list(dict.fromkeys(include_dirs))
    if not unique_dirs:
        fail(f"No ARM-R5 C include directories were discovered using {gcc}")

    return {
        "ARM_R5_GCC": str(gcc),
        "ARM_R5_GCC_BIN": str(gcc.parent),
        "ARM_R5_SYSROOT": str(sysroot) if sysroot is not None else "",
        "ARM_R5_INCLUDE_DIRS": os.pathsep.join(map(str, unique_dirs)),
    }


def discover_bsp_include_dir(
    workspace: Path,
    platform_name: str,
    domain_name: str,
) -> Path:
    preferred = (
        workspace
        / platform_name
        / "export"
        / platform_name
        / "sw"
        / domain_name
        / "include"
    )
    if (preferred / "xipipsu.h").is_file():
        return preferred.resolve()

    candidates = sorted(
        header.parent.resolve()
        for header in (workspace / platform_name).rglob("xipipsu.h")
        if (header.parent / "xparameters.h").is_file()
    )
    if len(candidates) == 1:
        return candidates[0]
    fail(
        "Unable to uniquely locate the generated RPU BSP include directory "
        f"beneath {workspace / platform_name}"
    )


def build_rust_rpu_application(
    cargo_root: Path,
    workspace: Path,
    platform_name: str,
    domain_name: str,
    package_name: str,
    target_name: str,
    linker_script: Path,
    release: bool,
    features: tuple[str, ...] = (),
) -> Path:
    cargo_executable = shutil.which("cargo")
    if cargo_executable is None:
        fail(
            "Cargo was not found in PATH. Install Rust and the "
            f"{target_name} target before building the Rust RPU firmware."
        )
    # ~/.cargo/bin/cargo is commonly a rustup shim. Do not resolve the
    # symlink or the child process would invoke rustup as if it were Cargo.
    cargo = Path(cargo_executable).absolute()
    bsp_include = discover_bsp_include_dir(
        workspace,
        platform_name,
        domain_name,
    )
    toolchain_env = discover_arm_r5_environment(derive_vitis_root())
    env = os.environ.copy()
    env.update(toolchain_env)
    env["BSP_INCLUDE_DIR"] = str(bsp_include)
    env["RPU_LINKER_SCRIPT"] = str(linker_script.resolve())
    env["PATH"] = (
        toolchain_env["ARM_R5_GCC_BIN"]
        + os.pathsep
        + env.get("PATH", "")
    )

    command = [
        str(cargo),
        "build",
        "--manifest-path",
        str(cargo_root / "Cargo.toml"),
        "--package",
        package_name,
        "--target",
        target_name,
        "--locked",
    ]
    if features:
        command.extend(["--features", ",".join(features)])
    if release:
        command.append("--release")

    info(
        f"Building Rust RPU package '{package_name}' for {target_name} "
        f"using BSP {bsp_include}"
    )
    subprocess.run(command, cwd=cargo_root, env=env, check=True)

    profile = "release" if release else "debug"
    elf = cargo_root / "target" / target_name / profile / package_name
    if not elf.is_file():
        fail(f"Cargo completed, but the RPU ELF was not found: {elf}")
    return elf.resolve()


def resolve_rpu_component_dir(
    rpu_elf: Path,
    explicit_component_dir: Optional[Path] = None,
) -> Path:
    """Resolve the Vitis application-component directory that owns an RPU ELF."""
    component_dir = (
        explicit_component_dir.resolve()
        if explicit_component_dir is not None
        else rpu_elf.parent.parent.resolve()
    )

    metadata = component_dir / "vitis-comp.json"
    if not metadata.is_file():
        fail(
            "Unable to expose the existing RPU application in Vitis because "
            f"component metadata was not found at {metadata}. "
            "Pass --rpu-component-dir with the directory containing "
            "vitis-comp.json, or use --rpu-source to create the component."
        )

    try:
        rpu_elf.resolve().relative_to(component_dir)
    except ValueError:
        fail(
            f"RPU ELF {rpu_elf} is not contained beneath the selected "
            f"RPU component directory {component_dir}"
        )

    return component_dir


def expose_existing_rpu_component(
    *,
    workspace: Path,
    component_dir: Path,
    app_name: str,
) -> Path:
    """Symlink an existing RPU application component into the PLM workspace."""
    destination = workspace / app_name
    source = component_dir.resolve()

    if destination.is_symlink():
        current = destination.resolve(strict=False)
        if current == source:
            info(f"RPU application component already exposed: {destination} -> {source}")
            return destination
        remove_path(destination)
    elif destination.exists():
        if destination.resolve() == source:
            info(f"RPU application component already present in workspace: {destination}")
            return destination
        fail(
            f"Cannot expose RPU component '{app_name}' because the workspace path "
            f"already exists and points elsewhere: {destination}"
        )

    destination.symlink_to(source, target_is_directory=True)
    success(f"RPU application component exposed in Vitis workspace: {destination} -> {source}")
    return destination

def launch_vitis_gui(workspace: Path) -> None:
    launcher = locate_vitis_launcher()
    if launcher is None:
        fail(
            "Unable to locate the Vitis launcher. Source the matching "
            "Vitis settings64.sh before using --launch-vitis."
        )

    command = [str(launcher), "-w", str(workspace)]
    info("Launching Vitis GUI: " + " ".join(command))

    # Launch Vitis with the inherited environment only. In particular, do not
    # inject IDE_DEBUG_FILTER_* variables; target selection is left to the
    # launch configuration and Vitis hardware target discovery.
    subprocess.Popen(
        command,
        cwd=str(workspace),
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def normalized_key(key: str) -> str:
    return re.sub(r"[^a-z0-9]", "", key.lower())


def tree_contains_text(node: object, needles: Iterable[str]) -> bool:
    normalized_needles = tuple(value.lower() for value in needles if value)
    if not normalized_needles:
        return False

    if isinstance(node, dict):
        return any(
            tree_contains_text(key, normalized_needles)
            or tree_contains_text(value, normalized_needles)
            for key, value in node.items()
        )

    if isinstance(node, list):
        return any(tree_contains_text(item, normalized_needles) for item in node)

    if isinstance(node, str):
        lowered = node.lower()
        return any(needle in lowered for needle in normalized_needles)

    return False


def patch_launch_tree(
    node: object,
    *,
    attach_to_running: bool,
    pdi_workspace_path: Optional[str] = None,
    path: str = "root",
) -> tuple[object, int]:
    if attach_to_running:
        replacements = {
            "targetsetupmode": "Attach to Running Target",
            "setuptype": "Attach to Running Target",
        }
        true_keys: set[str] = set()
        false_keys = {
            "enablecrosstriggering",
            "resetentiresystem",
            "resetsystem",
            "systemreset",
            "resetprocessor",
            "programdevice",
            "stopatentry",
            "stopatmain",
            "downloadapplication",
            "runafterdownload",
        }
    else:
        # Kept for callers that explicitly want a programming launch. The
        # default patch_launch_configs path now uses attach-to-running for both
        # PLM and RPU so the ELFs are used for symbols/source mapping only.
        replacements = {}
        true_keys = {
            "programdevice",
            "stopatentry",
        }
        false_keys = {
            "stopatmain",
        }

    changes = 0

    if isinstance(node, dict):
        result: dict[str, object] = {}

        for key, value in node.items():
            normalized = normalized_key(key)
            current_path = f"{path}.{key}"

            # Only non-attach launches need a PDI path. An RPU attach launch must
            # not program the device because the combined PDI already started R5-0.
            if (
                not attach_to_running
                and normalized == "pdifile"
                and pdi_workspace_path is not None
            ):
                if value != pdi_workspace_path:
                    info(
                        f"Changing {current_path}: "
                        f"{value!r} -> {pdi_workspace_path!r}"
                    )
                    value = pdi_workspace_path
                    changes += 1
            elif normalized in replacements:
                replacement = replacements[normalized]
                if value != replacement:
                    info(
                        f"Changing {current_path}: "
                        f"{value!r} -> {replacement!r}"
                    )
                    value = replacement
                    changes += 1
            elif normalized in true_keys:
                if value is not True:
                    info(f"Changing {current_path}: {value!r} -> True")
                    value = True
                    changes += 1
            elif normalized in false_keys:
                if value is not False:
                    info(f"Changing {current_path}: {value!r} -> False")
                    value = False
                    changes += 1

            value, nested_changes = patch_launch_tree(
                value,
                attach_to_running=attach_to_running,
                pdi_workspace_path=pdi_workspace_path,
                path=current_path,
            )
            changes += nested_changes
            result[key] = value

        normalized_keys = {normalized_key(key) for key in result}
        is_launch_config = (
            "launchconfigname" in normalized_keys
            or "debugtype" in normalized_keys
            or (
                "request" in normalized_keys
                and "type" in normalized_keys
                and "name" in normalized_keys
            )
        )

        if is_launch_config:
            if attach_to_running:
                required_values = {
                    "targetSetupMode": "Attach to Running Target",
                    "resetEntireSystem": False,
                    "resetProcessor": False,
                    "programDevice": False,
                    "downloadApplication": False,
                    "stopAtEntry": False,
                    "stopAtMain": False,
                    "runAfterDownload": False,
                    "enableCrossTriggering": False,
                }
            else:
                required_values = {
                    "programDevice": True,
                    "stopAtEntry": True,
                    "stopAtMain": False,
                }

            for key, required_value in required_values.items():
                normalized = normalized_key(key)
                matching_key = next(
                    (
                        existing_key
                        for existing_key in result
                        if normalized_key(existing_key) == normalized
                    ),
                    None,
                )

                if matching_key is None:
                    info(f"Adding {path}.{key}: {required_value!r}")
                    result[key] = required_value
                    changes += 1
                elif result[matching_key] != required_value:
                    info(
                        f"Changing {path}.{matching_key}: "
                        f"{result[matching_key]!r} -> {required_value!r}"
                    )
                    result[matching_key] = required_value
                    changes += 1

            if attach_to_running:
                attach_key = next(
                    (
                        key
                        for key in result
                        if normalized_key(key) == "attachtorunningtargetoptions"
                    ),
                    None,
                )
                if attach_key is None:
                    attach_key = "attachToRunningTargetOptions"
                    result[attach_key] = {}
                    changes += 1

                attach_options = result[attach_key]
            else:
                attach_options = None

            if isinstance(attach_options, dict):
                attach_defaults = {
                    "targetSetupMode": "Attach to Running Target",
                    "executeScript": False,
                    "scriptPath": "",
                    "resetProcessor": False,
                    "downloadApplication": False,
                    "stopAtEntry": False,
                }
                for key, required_value in attach_defaults.items():
                    matching_key = next(
                        (
                            existing_key
                            for existing_key in attach_options
                            if normalized_key(existing_key) == normalized_key(key)
                        ),
                        None,
                    )
                    if matching_key is None:
                        info(
                            f"Adding {path}.{attach_key}.{key}: "
                            f"{required_value!r}"
                        )
                        attach_options[key] = required_value
                        changes += 1
                    elif attach_options[matching_key] != required_value:
                        info(
                            f"Changing {path}.{attach_key}.{matching_key}: "
                            f"{attach_options[matching_key]!r} -> "
                            f"{required_value!r}"
                        )
                        attach_options[matching_key] = required_value
                        changes += 1

        return result, changes

    if isinstance(node, list):
        result_list: list[object] = []
        for index, item in enumerate(node):
            patched_item, nested_changes = patch_launch_tree(
                item,
                attach_to_running=attach_to_running,
                pdi_workspace_path=pdi_workspace_path,
                path=f"{path}[{index}]",
            )
            changes += nested_changes
            result_list.append(patched_item)
        return result_list, changes

    return node, changes


def remove_plm_attach_configuration(data: object) -> tuple[object, int]:
    """Remove the obsolete PLM attach-only configuration, if present."""
    if not isinstance(data, dict):
        return data, 0

    configurations = data.get("configurations")
    if not isinstance(configurations, list):
        return data, 0

    original_count = len(configurations)
    configurations[:] = [
        item
        for item in configurations
        if not (
            isinstance(item, dict)
            and item.get("name") == "plm_attach_running"
        )
    ]
    removed = original_count - len(configurations)
    if removed:
        info("Removed obsolete PLM attach-to-running configuration")
    return data, removed


def patch_rpu_source_path_map(
    node: object,
    path_map: list[dict[str, str]],
) -> tuple[object, int]:
    changes = 0

    if isinstance(node, dict):
        result: dict[str, object] = {}

        for key, value in node.items():
            if normalized_key(key) == "pathmap":
                if value != path_map:
                    value = path_map
                    changes += 1
            else:
                value, nested_changes = patch_rpu_source_path_map(
                    value,
                    path_map,
                )
                changes += nested_changes
            result[key] = value

        normalized_keys = {normalized_key(key) for key in result}
        is_launch_config = (
            "debugtype" in normalized_keys
            or (
                "request" in normalized_keys
                and "type" in normalized_keys
                and "name" in normalized_keys
            )
        )
        if is_launch_config and "pathmap" not in normalized_keys:
            result["pathMap"] = path_map
            changes += 1

        return result, changes

    if isinstance(node, list):
        result_list: list[object] = []
        for item in node:
            patched_item, nested_changes = patch_rpu_source_path_map(
                item,
                path_map,
            )
            result_list.append(patched_item)
            changes += nested_changes
        return result_list, changes

    return node, changes



def patch_launch_configs(
    workspace: Path,
    vitis_pdi: Optional[Path] = None,
    rpu_application_dir: Optional[Path] = None,
    rpu_app_name: Optional[str] = None,
    rpu_processor: Optional[str] = None,
    rpu_elf: Optional[Path] = None,
    rpu_source_root: Optional[Path] = None,
) -> None:
    launch_files = [
        path
        for path in workspace.rglob("launch.json")
        if ".git" not in path.parts
    ]

    if not launch_files:
        info("No launch.json files found to patch")
        return

    pdi_workspace_path: Optional[str] = None
    if vitis_pdi is not None:
        relative_pdi = vitis_pdi.resolve().relative_to(workspace.resolve())
        pdi_workspace_path = "${workspaceFolder}/" + relative_pdi.as_posix()

    rpu_elf_workspace_path: Optional[str] = None
    if rpu_elf is not None:
        relative_rpu_elf = rpu_elf.resolve().relative_to(workspace.resolve())
        rpu_elf_workspace_path = (
            "${workspaceFolder}/" + relative_rpu_elf.as_posix()
        )

    rpu_path_map: Optional[list[dict[str, str]]] = None
    if rpu_application_dir is not None and rpu_source_root is not None:
        component_source = (
            rpu_application_dir / "src" / "rust"
        ).resolve(strict=False).as_posix()
        real_source = rpu_source_root.resolve(strict=False).as_posix()
        rpu_path_map = [
            {
                "source": real_source,
                "destination": component_source,
            }
        ]

    for path in launch_files:
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as error:
            info(f"Skipping invalid launch.json {path}: {error}")
            continue

        path_is_rpu = False
        if rpu_application_dir is not None:
            try:
                path.resolve(strict=False).relative_to(
                    rpu_application_dir.resolve(strict=False)
                )
                path_is_rpu = True
            except ValueError:
                pass

        # Classify by component path for messaging and RPU-specific cleanup.
        # Both PLM and RPU launches attach to already-running firmware by
        # default.
        is_rpu_launch = path_is_rpu
        attach_to_running = True

        patched, changes = patch_launch_tree(
            data,
            attach_to_running=attach_to_running,
            pdi_workspace_path=pdi_workspace_path,
        )

        if is_rpu_launch and rpu_path_map is not None:
            patched, path_map_changes = patch_rpu_source_path_map(
                patched,
                rpu_path_map,
            )
            changes += path_map_changes

        if not is_rpu_launch:
            try:
                path.resolve(strict=False).relative_to(
                    (workspace / APPLICATION_NAME).resolve(strict=False)
                )
                patched, removed_changes = remove_plm_attach_configuration(
                    patched
                )
                changes += removed_changes
                if (
                    rpu_processor is not None
                    and rpu_app_name is not None
                    and isinstance(patched, dict)
                ):
                    applications_key = next(
                        (
                            key
                            for key in patched
                            if normalized_key(key) == "applications"
                        ),
                        None,
                    )
                    if applications_key is not None:
                        applications = patched[applications_key]
                        if isinstance(applications, list):
                            original_count = len(applications)

                            def is_rpu_entry(entry: object) -> bool:
                                if not isinstance(entry, dict):
                                    return False
                                processor = next(
                                    (
                                        value
                                        for key, value in entry.items()
                                        if normalized_key(key) == "processor"
                                    ),
                                    None,
                                )
                                if processor == rpu_processor:
                                    return True
                                values = [str(value).lower() for value in entry.values()]
                                if any(
                                    rpu_app_name.lower() in value
                                    for value in values
                                ):
                                    return True
                                if rpu_elf_workspace_path is not None:
                                    return any(
                                        rpu_elf_workspace_path.lower() in value
                                        for value in values
                                    )
                                return False

                            applications[:] = [
                                entry
                                for entry in applications
                                if not is_rpu_entry(entry)
                            ]
                            removed_rpu_rows = original_count - len(applications)
                            if removed_rpu_rows:
                                info(
                                    "Removed stale RPU application row from "
                                    f"PLM debug launch: {path}"
                                )
                                changes += removed_rpu_rows
                            if not applications:
                                del patched[applications_key]
                                changes += 1
            except ValueError:
                pass

        if changes == 0:
            mode = "RPU attach" if is_rpu_launch else "PLM attach"
            info(f"Launch config already has {mode} settings: {path}")
            continue

        path.write_text(
            json.dumps(patched, indent=2, ensure_ascii=True) + "\n",
            encoding="utf-8",
        )
        if is_rpu_launch:
            success(f"Configured RPU attach-to-running launch: {path}")
        else:
            success(f"Configured PLM attach-to-running launch: {path}")


def read_process_cmdline(pid: int) -> str:
    try:
        raw = (Path("/proc") / str(pid) / "cmdline").read_bytes()
    except (FileNotFoundError, PermissionError, ProcessLookupError):
        return ""

    return raw.replace(b"\0", b" ").decode("utf-8", errors="replace").strip()


def read_process_parent(pid: int) -> Optional[int]:
    try:
        fields = (Path("/proc") / str(pid) / "stat").read_text().split()
    except (FileNotFoundError, PermissionError, ProcessLookupError, ValueError):
        return None

    if len(fields) < 4:
        return None

    try:
        return int(fields[3])
    except ValueError:
        return None


def current_user_process_ids() -> set[int]:
    process_ids: set[int] = set()
    uid = os.getuid()

    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue

        try:
            if entry.stat().st_uid == uid:
                process_ids.add(int(entry.name))
        except (FileNotFoundError, PermissionError, ProcessLookupError):
            continue

    return process_ids


def vitis_server_root_processes() -> set[int]:
    roots: set[int] = set()

    for pid in current_user_process_ids():
        cmdline = read_process_cmdline(pid)
        if not cmdline:
            continue

        if "/Vitis/bin/vitis-server" in cmdline:
            roots.add(pid)

    return roots


def descendant_processes(root_pid: int) -> set[int]:
    descendants: set[int] = set()
    pending = [root_pid]
    parent_map: dict[int, list[int]] = {}

    for pid in current_user_process_ids():
        parent = read_process_parent(pid)
        if parent is not None:
            parent_map.setdefault(parent, []).append(pid)

    while pending:
        parent = pending.pop()
        for child in parent_map.get(parent, []):
            if child not in descendants:
                descendants.add(child)
                pending.append(child)

    return descendants


def process_is_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True




def path_is_within(candidate: Path, root: Path) -> bool:
    try:
        candidate.resolve(strict=False).relative_to(root.resolve(strict=False))
        return True
    except (ValueError, OSError):
        return False


def process_references_workspace(pid: int, workspace: Path) -> bool:
    proc = Path("/proc") / str(pid)

    try:
        cwd = proc.joinpath("cwd").resolve(strict=False)
        if path_is_within(cwd, workspace):
            return True
    except (FileNotFoundError, PermissionError, ProcessLookupError, OSError):
        pass

    fd_dir = proc / "fd"
    try:
        entries = list(fd_dir.iterdir())
    except (FileNotFoundError, PermissionError, ProcessLookupError, OSError):
        return False

    for entry in entries:
        try:
            target = entry.resolve(strict=False)
        except (FileNotFoundError, PermissionError, ProcessLookupError, OSError):
            continue
        if path_is_within(target, workspace):
            return True

    return False


def workspace_owner_processes(workspace: Path) -> set[int]:
    owners: set[int] = set()
    own_pid = os.getpid()

    for pid in current_user_process_ids():
        if pid == own_pid:
            continue

        cmdline = read_process_cmdline(pid)
        is_vitis_related = any(
            marker in cmdline
            for marker in (
                "/Vitis/",
                "vitis-server",
                "rigel_server",
                "com.xilinx.rigel",
            )
        )

        if is_vitis_related and process_references_workspace(pid, workspace):
            owners.add(pid)

    return owners


def describe_processes(process_ids: set[int]) -> str:
    descriptions = []
    for pid in sorted(process_ids):
        cmdline = read_process_cmdline(pid)
        descriptions.append(f"{pid}: {cmdline or '<unavailable>'}")
    return "; ".join(descriptions)


def terminate_processes(process_ids: set[int], description: str) -> None:
    live = {pid for pid in process_ids if process_is_alive(pid)}
    if not live:
        return

    info(
        f"Stopping {description}: "
        + ", ".join(str(pid) for pid in sorted(live))
    )

    for pid in sorted(live, reverse=True):
        try:
            os.kill(pid, signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            pass

    deadline = time.monotonic() + 5.0
    while time.monotonic() < deadline:
        remaining = {pid for pid in live if process_is_alive(pid)}
        if not remaining:
            return
        time.sleep(0.1)

    remaining = {pid for pid in live if process_is_alive(pid)}
    if remaining:
        info(
            "Vitis server did not exit after SIGTERM; sending SIGKILL to: "
            + ", ".join(str(pid) for pid in sorted(remaining))
        )

    for pid in sorted(remaining, reverse=True):
        try:
            os.kill(pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            pass


def terminate_vitis_server_roots(root_process_ids: set[int], description: str) -> None:
    process_ids: set[int] = set()
    for root_pid in root_process_ids:
        process_ids.update(descendant_processes(root_pid))
        process_ids.add(root_pid)

    terminate_processes(process_ids, description)


def close_vitis_client(client: object) -> None:
    close_method = getattr(client, "close", None)
    if close_method is None:
        return

    try:
        close_method()
    except Exception as error:
        info(f"Vitis client close reported an error: {error}")


def workspace_lock_candidates(workspace: Path) -> list[Path]:
    """Return known Vitis/Eclipse workspace lock files, if present."""
    candidates = [
        workspace / ".metadata" / ".lock",
        workspace / ".lock",
        workspace / ".vitis" / ".lock",
    ]
    return [path for path in candidates if path.exists() or path.is_symlink()]


def remove_stale_workspace_locks(workspace: Path) -> None:
    """Remove only known Vitis workspace locks after all servers are gone."""
    live_servers = vitis_server_root_processes()
    if live_servers:
        fail(
            "Refusing to remove workspace locks while Vitis server processes "
            "are still running: "
            + ", ".join(str(pid) for pid in sorted(live_servers))
        )

    for lock_path in workspace_lock_candidates(workspace):
        info(f"Removing stale workspace lock: {lock_path}")
        remove_path(lock_path)


def prepare_workspace_for_headless_build(workspace: Path) -> None:
    """
    Recover the workspace before create_client() starts its gRPC channel.

    Killing and restarting a Vitis server after a client already exists can
    leave Vitis Python background threads attached to a closed channel.
    """
    existing_servers = vitis_server_root_processes()
    if existing_servers:
        info(
            "Found a pre-existing Vitis server; stopping it before creating "
            "the build client"
        )
        terminate_vitis_server_roots(
            existing_servers,
            "pre-existing Vitis server",
        )

    owners = workspace_owner_processes(workspace)
    if owners:
        info(
            "Found Vitis-related processes with the workspace open; "
            "stopping them before creating the build client"
        )
        debug("Workspace owners: " + describe_processes(owners))
        terminate_processes(owners, "Vitis workspace owner processes")

    deadline = time.monotonic() + 5.0
    while time.monotonic() < deadline:
        if not vitis_server_root_processes() and not workspace_owner_processes(workspace):
            break
        time.sleep(0.1)

    remaining_servers = vitis_server_root_processes()
    remaining_owners = workspace_owner_processes(workspace)
    if remaining_servers or remaining_owners:
        details = []
        if remaining_servers:
            details.append(
                "server PIDs "
                + ", ".join(str(pid) for pid in sorted(remaining_servers))
            )
        if remaining_owners:
            details.append(
                "workspace owners " + describe_processes(remaining_owners)
            )
        fail("Unable to release the Vitis workspace: " + "; ".join(details))

    remove_stale_workspace_locks(workspace)


def create_client_and_set_workspace(
    vitis_module: object,
    workspace: Path,
) -> tuple[object, set[int]]:
    """Create one client and set the workspace once, without in-process retry."""
    preexisting_servers = vitis_server_root_processes()
    client = vitis_module.create_client()
    started_servers = vitis_server_root_processes() - preexisting_servers

    try:
        info("Setting Vitis workspace")
        client.set_workspace(path=str(workspace))
        return client, started_servers
    except Exception as error:
        close_vitis_client(client)
        terminate_vitis_server_roots(
            started_servers,
            "Vitis server started by the failed client attempt",
        )

        locks = workspace_lock_candidates(workspace)
        lock_text = ", ".join(str(path) for path in locks) if locks else "none"
        owners = workspace_owner_processes(workspace)
        owner_text = describe_processes(owners) if owners else "none"
        raise RuntimeError(
            f"Unable to set Vitis workspace: {error}. "
            f"Known workspace locks remaining: {lock_text}. "
            f"Vitis-related workspace owners remaining: {owner_text}"
        ) from error


def call_first_supported(
    owner: object,
    method_names: Iterable[str],
    argument_sets: Iterable[object],
) -> object:
    """
    Call the first available method/argument combination.

    Vitis Unified Python API names have changed between releases, so this
    helper tries the common variants without making workspace reuse depend
    on one exact spelling.
    """
    last_error: Optional[Exception] = None
    found_method = False

    for method_name in method_names:
        method = getattr(owner, method_name, None)
        if method is None:
            continue

        found_method = True

        for arguments in argument_sets:
            try:
                if isinstance(arguments, dict):
                    return method(**arguments)
                if isinstance(arguments, (tuple, list)):
                    return method(*arguments)
                return method(arguments)
            except TypeError as error:
                last_error = error
                continue
            except Exception:
                raise

    if not found_method:
        raise AttributeError(
            f"None of these methods exist: {', '.join(method_names)}"
        )

    if last_error is not None:
        raise last_error

    raise RuntimeError("No supported Vitis API call succeeded")


def get_existing_component(client: object, name: str, _kind: str) -> object:
    """
    Open an existing platform or application component from the workspace.
    """
    argument_sets = (
        {"name": name},
        (name,),
    )

    return call_first_supported(client, ("get_component",), argument_sets)


def create_platform(client: object, xsa: Path) -> object:
    info(f"Creating platform component '{PLATFORM_NAME}'")

    attempts = (
        {
            "name": PLATFORM_NAME,
            "hw_design": str(xsa),
            "os": "standalone",
            "cpu": PROCESSOR_NAME,
        },
    )

    return call_first_supported(
        client,
        ("create_platform_component",),
        attempts,
    )


def build_component(component: object, label: str) -> None:
    info(f"Building {label}")
    result = component.build()
    debug(f"{label}.build() returned: {result!r}")

    if result is None:
        return

    if isinstance(result, bool):
        if not result:
            fail(f"{label} build failed")
        return

    if isinstance(result, int):
        if result != 0:
            fail(f"{label} build failed with return code {result}")
        return

    if isinstance(result, str):
        normalized = result.strip().lower()
        if normalized in {"0", "success", "succeeded", "true"}:
            return
        fail(f"{label} build failed with result: {result}")

    fail(
        f"{label} returned an unsupported build result: "
        f"{result!r} ({type(result).__name__})"
    )


def export_platform(platform: object) -> None:
    export_method = getattr(platform, "export", None)

    if export_method is None:
        info("Platform has no export() method; using build output as-is")
        return

    info("Exporting platform")
    result = export_method()
    debug(f"platform.export() returned: {result}")


def resolve_exported_platform(workspace: Path) -> Path:
    expected = (
        workspace
        / PLATFORM_NAME
        / "export"
        / PLATFORM_NAME
        / "platform.xpfm"
    )

    if expected.is_file():
        return expected.resolve()

    discovered = sorted(
        (workspace / PLATFORM_NAME).glob("export/**/*.xpfm")
    )

    if discovered:
        return discovered[0].resolve()

    fail(
        "Unable to locate an exported .xpfm beneath "
        f"{workspace / PLATFORM_NAME / 'export'}"
    )


def add_platform_repository(client: object, exported_platform: Path) -> None:
    repository = exported_platform.parent

    attempts = (
        {"platform": [str(repository)]},
        ([str(repository)],),
    )

    try:
        call_first_supported(
            client,
            ("add_platform_repos", "add_platform_repo"),
            attempts,
        )
        info(f"Added platform repository: {repository}")
    except Exception as error:
        # Existing workspaces frequently already know this repository.
        info(
            "Platform repository was not added again; continuing with the "
            f"existing workspace registration ({error})"
        )


def create_plm_application(
