def info(message: str) -> None:
    print(f"[INFO] {message}", flush=True)


def debug(message: str) -> None:
    print(f"[DEBUG] {message}", flush=True)


def success(message: str) -> None:
    print(f"[SUCCESS] {message}", flush=True)


def fail(message: str) -> None:
    raise RuntimeError(message)


def absolute_path(value: str | Path) -> Path:
    return Path(value).expanduser().resolve()


def remove_path(path: Path) -> None:
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def symlink_or_copy(
    source: Path,
    destination: Path,
    use_symlink: bool,
) -> None:
    source_absolute = source.expanduser().absolute()
    destination_absolute = destination.expanduser().absolute()

    if source_absolute == destination_absolute:
        info(
            "Source and destination are identical; leaving file unchanged: "
            f"{source_absolute}"
        )
        return

    destination.parent.mkdir(parents=True, exist_ok=True)

    if destination.exists() or destination.is_symlink():
        remove_path(destination)

    if use_symlink:
        destination.symlink_to(source_absolute)
        info(f"Symlinked {destination} -> {source_absolute}")
    else:
        shutil.copy2(source_absolute, destination)
        info(f"Copied {source_absolute} -> {destination}")


def locate_vitis_launcher() -> Optional[Path]:
    executable = shutil.which("vitis")
    if executable:
        return Path(executable).resolve()

    vitis_root = os.environ.get("XILINX_VITIS")
    if vitis_root:
        candidate = Path(vitis_root) / "bin" / "vitis"
        if candidate.is_file():
            return candidate.resolve()

    return None



def require_host_tool(name: str) -> Path:
    executable = shutil.which(name)
    if executable is None:
        fail(
            f"Required tool '{name}' was not found in PATH. "
            "Source the matching Vitis settings64.sh first."
        )
    return Path(executable).resolve()


def extract_base_pdi_from_xsa(xsa: Path, output_dir: Path) -> Path:
    output_dir.mkdir(parents=True, exist_ok=True)

    try:
        archive = zipfile.ZipFile(xsa)
    except zipfile.BadZipFile as error:
        fail(f"XSA is not a readable ZIP archive: {xsa}: {error}")

    with archive:
        members = [
            name
            for name in archive.namelist()
            if name.lower().endswith(".pdi")
        ]

        if not members:
            fail(
                "No PDI was found inside the XSA. Export the Versal XSA "
                "with the device image included."
            )

        preferred_names = {
            "system.pdi",
            "design.pdi",
            f"{xsa.stem.lower()}.pdi",
        }
        preferred = [
            name
            for name in members
            if Path(name).name.lower() in preferred_names
        ]

        if len(preferred) == 1:
            selected = preferred[0]
        elif len(members) == 1:
            selected = members[0]
        else:
            listing = "\n".join(f"  {name}" for name in members)
            fail(
                "Multiple PDI files were found inside the XSA and no "
                f"unique base PDI could be selected:\n{listing}"
            )

        output = output_dir / Path(selected).name
        with archive.open(selected) as source, output.open("wb") as destination:
            shutil.copyfileobj(source, destination)

    if not output.is_file() or output.stat().st_size == 0:
        fail(f"Failed to extract a valid base PDI from XSA: {xsa}")

    info(f"Extracted base PDI from XSA: {output}")
    return output


def verify_rpu_in_pdi(
    *,
    pdi: Path,
    expected_core: str,
    expected_image_name: str = "rpu_ipi_ping_pong",
) -> None:
    bootgen = require_host_tool("bootgen")

    command = [
        str(bootgen),
        "-arch",
        "versal",
        "-read",
        str(pdi),
    ]

    info("Verifying generated PDI: " + " ".join(command))

    result = subprocess.run(
        command,
        check=False,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
    )

    output = result.stdout + result.stderr

    if result.returncode != 0:
        fail(
            "bootgen failed while inspecting the generated PDI:\n"
            + output
        )

    readback_file = pdi.with_suffix(".read.txt")
    readback_file.write_text(
        output,
        encoding="utf-8",
        errors="replace",
    )

    normalized = output.lower()
    expected_core_text = f"core: {expected_core}".lower()
    expected_image_prefix = expected_image_name[:16].lower()

    if expected_image_prefix not in normalized:
        fail(
            "Generated PDI does not contain the expected RPU image "
            f"'{expected_image_name}'. Inspect: {readback_file}"
        )

    if expected_core_text not in normalized:
        fail(
            "Generated PDI does not contain the expected RPU core "
            f"'{expected_core}'. Inspect: {readback_file}"
        )

    success(
        "Verified RPU image in generated PDI: "
        f"{expected_image_name} ({expected_core})"
    )

def generate_custom_plm_pdi(
    *,
    workspace: Path,
    xsa: Path,
    plm_elf: Path,
    rpu_elf: Optional[Path] = None,
    rpu_core: str = "r5-0",
    install_for_vitis: bool = True,
    output_stem: Optional[str] = None,
) -> Path:
    """Generate a replacement PDI containing the custom PLM and optional RPU ELF.

    When install_for_vitis is true, copy the generated PDI to the PLM launch
    resource path expected by Vitis. Production combined PDIs use
    install_for_vitis=false so they cannot accidentally replace the PLM-only
    debug PDI.
    """
    bootgen = require_host_tool("bootgen")

    if output_stem is None:
        output_stem = (
            "PLM_RPU_PRODUCTION" if rpu_elf is not None else "PLM_CUSTOM_JTAG"
        )
    output_bif = workspace / f"{output_stem}.bif"
    output_pdi = workspace / f"{output_stem}.pdi"
    resource_dir = workspace / APPLICATION_NAME / "_ide" / "bootimage" / "resources"
    resource_dir.mkdir(parents=True, exist_ok=True)

    # Vitis-generated launch configurations normally expect the XSA basename.
    vitis_pdi = resource_dir / f"{xsa.stem}.pdi"
    temporary_dir = workspace / ".build-plm-pdi"

    if temporary_dir.exists() or temporary_dir.is_symlink():
        remove_path(temporary_dir)
    temporary_dir.mkdir(parents=True)

    try:
        base_pdi = extract_base_pdi_from_xsa(xsa, temporary_dir)

        # Match the previously validated BIF structure:
        #
        # - Explicitly identify the PMC subsystem image.
        # - Replace its PLM bootloader.
        # - Import the remaining base PDI contents.
        # - Add the RPU application as def_subsystem with image ID 0x1C000000.
        lines = [
            "new_bif:",
            "{",
            "\timage",
            "\t{",
            "\t\tname = pmc_subsys",
            "\t\tid = 0x1C000001",
            "",
            "\t\tpartition",
            "\t\t{",
            "\t\t\ttype = bootloader",
            f'\t\t\tfile = "{plm_elf}"',
            "\t\t}",
            "",
            "\t\tpartition",
            "\t\t{",
            "\t\t\ttype = bootimage",
            f'\t\t\tfile = "{base_pdi}"',
            "\t\t}",
            "\t}",
        ]

        if rpu_elf is not None:
            if not rpu_elf.is_file():
                fail(f"RPU ELF not found: {rpu_elf}")

            lines.extend(
                [
                    "",
                    "\timage",
                    "\t{",
                    "\t\tname = def_subsystem",
                    "\t\tid = 0x1C000000",
                    "",
                    "\t\tpartition",
                    "\t\t{",
                    f"\t\t\tcore = {rpu_core}",
                    f'\t\t\tfile = "{rpu_elf}"',
                    "\t\t}",
                    "\t}",
                ]
            )

        lines.extend(["}", ""])
        output_bif.write_text("\n".join(lines), encoding="utf-8")
        info(f"Generated BIF: {output_bif}")

        stale_paths = [output_pdi]
        if install_for_vitis:
            stale_paths.append(vitis_pdi)
        for stale in stale_paths:
            if stale.exists() or stale.is_symlink():
                remove_path(stale)

        command = [
            str(bootgen),
            "-arch",
            "versal",
            "-image",
            str(output_bif),
            "-w",
            "-o",
            str(output_pdi),
        ]

        info("Generating custom PDI: " + " ".join(command))
        subprocess.run(
            command,
            cwd=str(workspace),
            check=True,
        )

        if not output_pdi.is_file() or output_pdi.stat().st_size == 0:
            fail(f"bootgen did not create a valid PDI: {output_pdi}")

        if rpu_elf is not None:
            verify_rpu_in_pdi(
                pdi=output_pdi,
                expected_core=rpu_core,
                expected_image_name="def_subsystem",
            )

        if install_for_vitis:
            shutil.copy2(output_pdi, vitis_pdi)

    finally:
        if temporary_dir.exists() or temporary_dir.is_symlink():
            remove_path(temporary_dir)

    success(f"Custom PDI generated: {output_pdi}")
    if install_for_vitis:
        success(f"Vitis launch PDI installed: {vitis_pdi}")

    if rpu_elf is not None:
        success(
            f"Combined PDI verified with RPU ELF: "
            f"{rpu_elf} ({rpu_core})"
        )

    return vitis_pdi if install_for_vitis else output_pdi

def resolve_exported_platform_named(workspace: Path, platform_name: str) -> Path:
    expected = workspace / platform_name / "export" / platform_name / "platform.xpfm"
    if expected.is_file():
        return expected.resolve()
    discovered = sorted((workspace / platform_name).glob("export/**/*.xpfm"))
    if discovered:
        return discovered[0].resolve()
    fail(f"Unable to locate exported platform beneath {workspace / platform_name / 'export'}")


